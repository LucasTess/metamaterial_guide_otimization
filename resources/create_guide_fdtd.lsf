# create_guide_fdtd.lsf
groupscope("::model");
deleteall;
clc;
clear;

#########################################################################################################
# Cria o grupo do Guia
addstructuregroup;
set("name","Guia Metamaterial");
set("x", 0);
set("y", 0);
set("z", 0);

adduserprop("s", 2, 1.1606755209336981e-07);
adduserprop("w", 2, 3.7417605321431565e-07);
adduserprop("l", 2, 2.2316333150558865e-07);
adduserprop("height", 2, 2.6090633471166995e-07);
adduserprop("total_length", 2, 4.650955379733395e-05);
 
adduserprop("index", 0, 3.5);
adduserprop("material", 5, 'Si (Silicon) - Palik');


total_length = getnamed("Guia Metamaterial", "total_length");

# Cria substrato
addrect;
set("material", 'SiO2 (Glass) - Palik');
set("name","Substrato - SiO2");
set("x",0);
set("x span", total_length*1.2);
set("y", 0);
set("y span", 10e-6);
set("z", -0.22e-6);
set("z span", 0.22e-6);

# Cria Agua
addrect;
set("material", 'Agua_deion');
set("name","Agua");
set("x",0);
set("x span", total_length*1.2);
set("y", 0);
set("y span", 10e-6);
set("z", 0);
set("z span", 0.8e-6);
set("alpha", 0.4);



 # Garante que o grupo está selecionado
select("Guia Metamaterial");
#Escreve o script
set("construction group", 1);
string = pwd() + '/resources/metamaterial_guide.lsf';
set("script", read(string));
var_read = get("total_length");
?"Valor de total_length retornado do construtor: " + num2str(var_read);